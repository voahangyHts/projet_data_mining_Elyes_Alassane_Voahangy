# Copier ce fichier en .env et changer les mots de passe.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# Data lake RustFS (S3)
S3_ACCESS_KEY=panieradmin
S3_SECRET_KEY=change-moi-panier-vert

# Base PostgreSQL de restitution
PG_USER=panier
PG_PASSWORD=change-moi
PG_DB=panier_vert

# Comptes du dashboard : un compte par ligne, DASHBOARD_COMPTE_<IDENTIFIANT>='<role>|<empreinte>'
# Rôles : direction, metier (CRM / Qualité), data (Équipe Data).
# Le mot de passe n'est JAMAIS écrit ici : seulement son empreinte (hachage PBKDF2).
# Pour créer une ligne : uv run python -m dashboard.auth <identifiant> <role>
DASHBOARD_COMPTE_DIRECTION='direction|<empreinte générée par dashboard.auth>'
DASHBOARD_COMPTE_CRM='metier|<empreinte générée par dashboard.auth>'
DASHBOARD_COMPTE_DATA='data|<empreinte générée par dashboard.auth>'
